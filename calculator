<!DOCTYPE html>
<html lang="ko" data-theme="yellow">
<head>
<meta charset="UTF-8">
<!-- 휴대폰에서 화면 폭에 맞추고, 노치(아이폰) 영역까지 고려 -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#d9a300">
<title>공학용 계산기</title>
<style>
/* =========================================================
   1. 테마 색상 (CSS 변수)
   - data-theme 값만 바꾸면 전체 색이 바뀜
   - 기본값: yellow (짙은 노랑)
   ========================================================= */
:root, [data-theme="yellow"] {
  --pin-bg: #fff8dc; --pin-fg: #8a3b00; --pin-line: #a87700;   /* 자주 쓰는 수식 키 */
  --bg: #d9a300;            /* 바탕 */
  --bg2: #c48f00;           /* 바탕 그라데이션 아래쪽 */
  --head-fg: #3a2900;       /* 상단 제목 글자 */
  --display-bg: #fff8dc;    /* 계산 화면 */
  --display-fg: #3a2900;
  --muted: #8a6d22;         /* 흐린 글자 */
  --num-bg: #fff3c4;  --num-fg: #3a2900;   /* 숫자 키 */
  --fn-bg: #a87700;   --fn-fg: #fff8e1;    /* 함수 키 */
  --op-bg: #5a3e00;   --op-fg: #ffd84d;    /* 연산자 키 */
  --ctl-bg: #7d5a00;  --ctl-fg: #fff3c4;   /* 조작 키 */
  --eq-bg: #d9480f;   --eq-fg: #ffffff;    /* = 키 */
  --tab-bg: #b98400;  --tab-fg: #fff3c4; --tab-on-bg: #fff8dc; --tab-on-fg: #3a2900;
  --panel-bg: #fff8dc; --panel-fg: #3a2900; --line: #e9d9a6;
  --accent: #d9480f;  --err: #c0262d;
  --ph: #c9a74a;            /* 빈칸 상자 테두리 */
  --shadow: 0 2px 0 rgba(0,0,0,.18);
}
[data-theme="night"] {
  --pin-bg: #2c4466; --pin-fg: #ffe08a; --pin-line: #ffd166;   /* 자주 쓰는 수식 키 */
  --bg: #121a2b; --bg2: #0a0f1a; --head-fg: #e6ebf5;
  --display-bg: #1c2740; --display-fg: #eef2fa; --muted: #8b98b5;
  --num-bg: #2a3654; --num-fg: #eef2fa;
  --fn-bg: #1f4a73; --fn-fg: #d8ecff;
  --op-bg: #3a4766; --op-fg: #ffd166;
  --ctl-bg: #33405e; --ctl-fg: #cdd6ea;
  --eq-bg: #ffb703; --eq-fg: #1b1b1b;
  --tab-bg: #24304b; --tab-fg: #aab6d0; --tab-on-bg: #ffd166; --tab-on-fg: #1b1b1b;
  --panel-bg: #1c2740; --panel-fg: #eef2fa; --line: #2f3c5c;
  --accent: #ffb703; --err: #ff7b7b; --ph: #5d6b8c;
  --shadow: 0 2px 0 rgba(0,0,0,.35);
}
[data-theme="mint"] {
  --pin-bg: #ffffff; --pin-fg: #0f4d41; --pin-line: #17705f;   /* 자주 쓰는 수식 키 */
  --bg: #2aa78f; --bg2: #1d8a75; --head-fg: #f2fffb;
  --display-bg: #effcf8; --display-fg: #0f3d34; --muted: #4f8a7d;
  --num-bg: #ffffff; --num-fg: #0f3d34;
  --fn-bg: #17705f; --fn-fg: #e6fff8;
  --op-bg: #0f4d41; --op-fg: #b8ffe9;
  --ctl-bg: #1a5e51; --ctl-fg: #e6fff8;
  --eq-bg: #ff7a59; --eq-fg: #ffffff;
  --tab-bg: #1f8c77; --tab-fg: #d9fff5; --tab-on-bg: #effcf8; --tab-on-fg: #0f3d34;
  --panel-bg: #effcf8; --panel-fg: #0f3d34; --line: #c7ebe1;
  --accent: #ff7a59; --err: #c62828; --ph: #7fbcae;
  --shadow: 0 2px 0 rgba(0,0,0,.15);
}
[data-theme="sakura"] {
  --pin-bg: #ffffff; --pin-fg: #7a2347; --pin-line: #c2507a;   /* 자주 쓰는 수식 키 */
  --bg: #f19bb3; --bg2: #e47d9b; --head-fg: #4a1428;
  --display-bg: #fff4f7; --display-fg: #4a1428; --muted: #a0577a;
  --num-bg: #ffffff; --num-fg: #4a1428;
  --fn-bg: #c2507a; --fn-fg: #fff0f5;
  --op-bg: #7a2347; --op-fg: #ffd3e2;
  --ctl-bg: #9c3a62; --ctl-fg: #fff0f5;
  --eq-bg: #6a3fb5; --eq-fg: #ffffff;
  --tab-bg: #d76890; --tab-fg: #fff0f5; --tab-on-bg: #fff4f7; --tab-on-fg: #4a1428;
  --panel-bg: #fff4f7; --panel-fg: #4a1428; --line: #f5d0dc;
  --accent: #6a3fb5; --err: #c0262d; --ph: #e0a0b8;
  --shadow: 0 2px 0 rgba(0,0,0,.15);
}
[data-theme="ocean"] {
  --pin-bg: #ffffff; --pin-fg: #123a63; --pin-line: #1d4f86;   /* 자주 쓰는 수식 키 */
  --bg: #2f6fb3; --bg2: #245890; --head-fg: #f0f7ff;
  --display-bg: #f0f7ff; --display-fg: #12304f; --muted: #557aa3;
  --num-bg: #ffffff; --num-fg: #12304f;
  --fn-bg: #1d4f86; --fn-fg: #e3f0ff;
  --op-bg: #123a63; --op-fg: #9fd3ff;
  --ctl-bg: #2a5d94; --ctl-fg: #e3f0ff;
  --eq-bg: #ffb020; --eq-fg: #1b1b1b;
  --tab-bg: #3a7cc0; --tab-fg: #e3f0ff; --tab-on-bg: #f0f7ff; --tab-on-fg: #12304f;
  --panel-bg: #f0f7ff; --panel-fg: #12304f; --line: #cfe0f3;
  --accent: #e08a00; --err: #c0262d; --ph: #8fb2d8;
  --shadow: 0 2px 0 rgba(0,0,0,.18);
}
[data-theme="contrast"] {
  --pin-bg: #000000; --pin-fg: #ffff00; --pin-line: #ffff00;   /* 자주 쓰는 수식 키 */
  --bg: #000000; --bg2: #000000; --head-fg: #ffffff;
  --display-bg: #000000; --display-fg: #ffffff; --muted: #cccccc;
  --num-bg: #ffffff; --num-fg: #000000;
  --fn-bg: #000000; --fn-fg: #ffff00;
  --op-bg: #000000; --op-fg: #00ffff;
  --ctl-bg: #000000; --ctl-fg: #ffffff;
  --eq-bg: #ffff00; --eq-fg: #000000;
  --tab-bg: #000000; --tab-fg: #ffffff; --tab-on-bg: #ffff00; --tab-on-fg: #000000;
  --panel-bg: #000000; --panel-fg: #ffffff; --line: #666666;
  --accent: #ffff00; --err: #ff6b6b; --ph: #aaaaaa;
  --shadow: inset 0 0 0 2px #ffffff;
}

/* =========================================================
   2. 기본 설정
   ========================================================= */
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: system-ui, -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
  background: linear-gradient(180deg, var(--bg), var(--bg2));
  color: var(--display-fg);
  min-height: 100vh;
  min-height: 100dvh;
  -webkit-tap-highlight-color: transparent;   /* 휴대폰 터치 시 파란 박스 없애기 */
}
button { font-family: inherit; }

/* 전체 틀: 위(제목줄) + 아래(본문) */
.app {
  display: flex; flex-direction: column;
  min-height: 100vh; min-height: 100dvh;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
}

/* =========================================================
   3. 상단 제목줄
   ========================================================= */
.topbar {
  flex: none;
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  height: 48px; padding: 0 12px;
  color: var(--head-fg);
}
.topbar h1 { font-size: 18px; margin: 0; font-weight: 800; letter-spacing: -0.3px; white-space: nowrap; }
.top-actions { display: flex; gap: 6px; }
.top-btn {
  height: 34px; padding: 0 12px; border-radius: 17px; border: 0;
  background: var(--display-bg); color: var(--display-fg);
  font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap;
  box-shadow: var(--shadow);
}
.top-btn .count {
  display: inline-block; min-width: 20px; padding: 0 5px; margin-left: 4px;
  border-radius: 10px; background: var(--accent); color: #fff; font-size: 12px; line-height: 20px; text-align: center;
}
[data-theme="contrast"] .top-btn { border: 2px solid #fff; }

/* =========================================================
   4. 본문 배치
   - 좁은 화면(휴대폰): 계산기만 보이고, 기록은 아래에서 올라오는 창
   - 넓은 화면(태블릿 가로, 노트북): 계산기 + 기록 나란히
   ========================================================= */
.layout {
  flex: 1;
  display: flex; justify-content: center; gap: 14px;
  padding: 0 10px 10px;
  /* 화면 높이에 맞추되, 너무 낮으면 스크롤 되도록 최소 높이 지정 */
  height: calc(100dvh - 48px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  min-height: 500px;
}
.calc {
  flex: 1 1 auto; width: 100%; max-width: 520px; min-width: 0;
  display: flex; flex-direction: column; gap: 8px;
}

/* =========================================================
   5. 계산 화면 (교과서 모양 수식 입력칸 + 결과)
   ========================================================= */
.display {
  flex: none;
  background: var(--display-bg); color: var(--display-fg);
  border-radius: 16px; padding: 8px 12px 10px;
  box-shadow: var(--shadow);
  display: flex; flex-direction: column; gap: 2px; min-width: 0;
}
[data-theme="contrast"] .display { border: 2px solid #fff; }
.disp-top { display: flex; align-items: center; gap: 8px; min-height: 22px; font-size: 12px; color: var(--muted); }
.badge {
  flex: none; padding: 1px 7px; border-radius: 6px; font-weight: 800; font-size: 11px;
  background: var(--accent); color: #fff; letter-spacing: .5px;
}
[data-theme="contrast"] .badge, [data-theme="night"] .badge { color: #000; }
.ans-info { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kbd-btn {
  flex: none; border: 1px solid var(--line); background: transparent; color: var(--muted);
  border-radius: 6px; font-size: 12px; padding: 2px 6px; cursor: pointer; display: none;
}
.kbd-btn.on { background: var(--accent); color: #fff; border-color: var(--accent); }
/* 휴대폰 자판으로 입력할 때 글자를 받는 숨은 칸 (화면에는 안 보임) */
#kbdSink { position: fixed; left: 0; top: 0; width: 1px; height: 1px; opacity: 0; font-size: 16px; border: 0; padding: 0; pointer-events: none; }

/* 수식 입력칸: 분수, 지수, 루트가 교과서 모양 그대로 보이고, 빈칸을 눌러 커서를 옮김 */
.editor {
  min-height: 74px; padding: 6px 2px;
  font-family: "Cambria Math", "STIX Two Math", "Latin Modern Math", "Times New Roman", serif;
  font-size: 26px; line-height: 1.25;
  white-space: nowrap; overflow-x: auto; overflow-y: hidden;
  display: flex; align-items: center;
  border-bottom: 1px dashed var(--line);
  outline: none; cursor: text;
  scrollbar-width: thin;
  -webkit-user-select: none; user-select: none;
}
.editor:focus-visible { border-bottom-color: var(--accent); }
.editor > .row { padding: 0 6px 0 2px; }
.editor .hint { font-family: system-ui, sans-serif; font-size: 13px; color: var(--muted); white-space: normal; line-height: 1.4; }

/* 결과 줄 */
.result {
  min-height: 40px;
  display: flex; align-items: center; justify-content: flex-end; gap: 10px;
  font-size: 30px; font-weight: 700;
  white-space: nowrap; overflow-x: auto; overflow-y: hidden;
  font-variant-numeric: tabular-nums;
}
.result .val { opacity: .45; }               /* 입력 중 미리 보는 결과는 흐리게 */
.result.final .val { opacity: 1; }           /* = 누른 뒤에는 진하게 */
.result .err { font-size: 15px; font-weight: 700; color: var(--err); white-space: normal; text-align: right; }
.result .fracchip {
  font-family: "Cambria Math", "Times New Roman", serif; font-weight: 400;
  font-size: 18px; padding: 2px 8px; border-radius: 8px; border: 1px solid var(--line); color: var(--muted);
}

/* ---------- 수식 모양 (분수, 지수, 루트, 괄호 등) ---------- */
.row { display: inline-block; }
.m-op { margin: 0 .18em; }
.m-comma { margin-right: .2em; }
.m-e { font-style: italic; }
.m-ans { font-family: system-ui, sans-serif; font-size: .75em; font-weight: 700; padding: 0 .1em; }
.m-fn { font-family: system-ui, sans-serif; font-size: .8em; }
.m-let { font-family: system-ui, sans-serif; font-size: .8em; color: var(--muted); }
/* 빈칸 상자 □ */
.m-ph {
  display: inline-block; min-width: .62em; height: .95em; vertical-align: -.12em;
  border: 1.5px dashed var(--ph); border-radius: 3px; margin: 0 .06em;
  text-align: left;
}
.m-ph.on { border-style: solid; border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
/* 깜박이는 커서 */
.cur {
  display: inline-block; width: 2px; height: 1.05em; margin: 0 -1px; vertical-align: -.18em;
  background: var(--accent); animation: blink 1s steps(1) infinite;
}
.m-ph .cur { vertical-align: top; margin-left: 1px; height: 100%; }
@keyframes blink { 50% { opacity: 0; } }
/* 분수 */
.m-frac {
  display: inline-flex; flex-direction: column; align-items: center;
  vertical-align: middle; margin: 0 .12em; font-size: .9em;
}
.m-frac > .fn, .m-frac > .fd { align-self: stretch; text-align: center; }   /* 분수 선이 분자·분모 중 넓은 쪽에 맞게 */
.m-frac > .fn { padding: 0 .2em .06em; border-bottom: 1.5px solid currentColor; }
.m-frac > .fd { padding: .06em .2em 0; }
/* 지수(위첨자), 아래첨자 */
.m-sup { display: inline-block; font-size: .66em; vertical-align: .8em; line-height: 1; }
.m-sub { display: inline-block; font-size: .66em; vertical-align: -.55em; line-height: 1; }   /* 아래첨자: 기준선 아래로 */
/* 루트: 글꼴마다 √ 모양이 달라서 그림(SVG)으로 직접 그림 → 모든 기기에서 같은 모양 */
.m-sqrt { display: inline-block; position: relative; padding-left: .62em; margin: 0 .05em; }
.m-sqrt.has-idx { padding-left: .85em; }
.m-sqrt .sign { position: absolute; left: 0; top: 0; bottom: 0; width: .62em; height: 100%; overflow: visible; }
.m-sqrt.has-idx .sign { left: .23em; }
.m-sqrt .body { display: inline-block; border-top: 1.5px solid currentColor; padding: .12em .12em 0 .04em; line-height: 1.1; }
.m-sqrt .idx { position: absolute; left: 0; top: -.05em; font-size: .55em; line-height: 1; }
/* 괄호: 안에 분수가 있으면 괄호도 같이 커지도록 그림으로 그림 */
.m-par { display: inline-block; position: relative; padding: 0 .36em; }
.m-par > .pl, .m-par > .pr { position: absolute; top: 0; height: 100%; width: .32em; overflow: visible; }
.m-par > .pl { left: .02em; } .m-par > .pr { right: .02em; }
.m-par > .row { padding: .04em 0; }
.m-abs { display: inline-block; border-left: 1.5px solid currentColor; border-right: 1.5px solid currentColor; padding: .04em .15em; margin: 0 .1em; }
.sign path, .pl path, .pr path { fill: none; stroke: currentColor; stroke-width: 1.5px; vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
.m-ghost { opacity: .35; }
.m-sci { font-size: .8em; }
.m-sci .m-sup { font-size: .75em; }

/* =========================================================
   6. 키패드
   - 한 개의 격자(5칸)로 모든 버튼을 배치 → 칸이 겹칠 일이 없음
   - 행 높이는 화면 높이에 맞춰 늘어나고, 최소 높이 보장
   ========================================================= */
.keys {
  flex: 1 1 0; min-height: 0;     /* 남은 높이를 키패드가 나눠 가짐 */
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  grid-template-rows:
    34px                              /* 탭 줄 */
    repeat(3, minmax(34px, 1fr))      /* 함수 키 3줄 (탭에 따라 바뀜) */
    minmax(38px, 1.1fr)               /* 자주 쓰는 수식 키 줄 (분수, 제곱 등) */
    minmax(34px, .85fr)               /* 조작 키 줄 (◀ ▶ DEG ⌫ AC) */
    repeat(4, minmax(40px, 1.25fr));  /* 숫자 키 4줄 */
  gap: 6px;
}
.tabs { grid-column: 1 / -1; display: flex; gap: 6px; min-width: 0; }
.tab {
  flex: 1 1 0; min-width: 0; border: 0; border-radius: 10px;
  background: var(--tab-bg); color: var(--tab-fg);
  font-size: 14px; font-weight: 700; cursor: pointer;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tab.on { background: var(--tab-on-bg); color: var(--tab-on-fg); box-shadow: var(--shadow); }
[data-theme="contrast"] .tab { border: 2px solid #fff; }

.key {
  min-width: 0; min-height: 0; width: 100%; height: 100%;
  border: 0; border-radius: 12px; padding: 0 2px;
  font-size: 18px; font-weight: 600; line-height: 1;
  cursor: pointer; user-select: none; -webkit-user-select: none;
  touch-action: manipulation;          /* 두 번 탭해도 화면 확대 안 되게 */
  box-shadow: var(--shadow);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; white-space: nowrap;
  transition: transform .05s, filter .1s;
}
.key:active, .key.pressed { transform: translateY(2px); filter: brightness(.88); box-shadow: none; }
.key:focus-visible, .tab:focus-visible, .top-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.kl { display: inline-block; line-height: 1; white-space: nowrap; }
/* 버튼 위 첨자: 위첨자(지수)는 밑의 오른쪽 위 모서리에, 아래첨자(밑, n, r)는 기준선 아래로 확실히
   position 으로 옮겨서 버튼 높이에는 영향 없이 위치만 바뀜 */
.key sup, .key sub { font-size: .6em; line-height: 0; vertical-align: baseline; position: relative; margin-left: .06em; }
.key sup { top: -.95em; }        /* 위로: 위첨자 아랫부분이 밑 글자 윗부분과 맞닿는 높이 */
.key sub { top: .8em; }          /* 아래로: 아래첨자가 밑 글자의 기준선 아래로 내려오게 */
.key sub:first-child { margin-left: 0; margin-right: .06em; }   /* ₙPᵣ 의 앞쪽 n */
.key sup:first-child { margin-left: 0; margin-right: -.1em; }   /* ʸ√ 의 차수 */
.k-num { background: var(--num-bg); color: var(--num-fg); font-size: 22px; }
.k-fn  { background: var(--fn-bg);  color: var(--fn-fg);  font-size: 16px; }
.k-op  { background: var(--op-bg);  color: var(--op-fg);  font-size: 24px; }
.k-ctl { background: var(--ctl-bg); color: var(--ctl-fg); font-size: 16px; }
.k-eq  { background: var(--eq-bg);  color: var(--eq-fg);  font-size: 26px; font-weight: 800; }
.k-pin { background: var(--pin-bg); color: var(--pin-fg); font-size: 20px; box-shadow: inset 0 0 0 2px var(--pin-line), var(--shadow); }
/* 버튼 위 작은 빈칸 그림 (누르면 이런 빈칸이 생긴다는 뜻) */
.kbox { display: inline-block; width: .62em; height: .72em; border: 1.5px solid currentColor; border-radius: 2px; vertical-align: -.05em; opacity: .9; }
.key sup .kbox, .key sub .kbox { width: .8em; height: .9em; vertical-align: baseline; }
.kfrac { display: inline-flex; flex-direction: column; align-items: center; gap: 1px; vertical-align: middle; }
.kfrac .kbox { width: .62em; height: .5em; }   /* 키가 낮아져도 넘치지 않게 작게 */
.kfrac .kbox:first-child { border-bottom-width: 1.5px; }
.kfrac::after { content: ""; order: 1; width: 1.1em; height: 2px; background: currentColor; }
.kfrac .kbox:last-child { order: 2; }
.k-small { font-size: 14px !important; }
.k-tiny  { font-size: 13px !important; }
[data-theme="contrast"] .k-fn, [data-theme="contrast"] .k-op, [data-theme="contrast"] .k-ctl { box-shadow: inset 0 0 0 2px #fff; }

/* =========================================================
   7. 계산 기록 창
   ========================================================= */
.history {
  background: var(--panel-bg); color: var(--panel-fg);
  border-radius: 16px; box-shadow: var(--shadow);
  display: flex; flex-direction: column; min-height: 0; min-width: 0;
}
[data-theme="contrast"] .history { border: 2px solid #fff; }
.h-head { flex: none; display: flex; align-items: center; gap: 6px; padding: 10px 12px 8px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.h-head h2 { margin: 0; font-size: 16px; flex: 1 1 auto; white-space: nowrap; }
.h-btn {
  height: 30px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line);
  background: transparent; color: inherit; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap;
}
.h-btn.danger.armed { background: var(--err); color: #fff; border-color: var(--err); }
.h-close { display: none; }
.h-list { flex: 1 1 auto; min-height: 0; overflow-y: auto; list-style: none; margin: 0; padding: 4px 0; -webkit-overflow-scrolling: touch; }
.h-item {
  display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 8px; align-items: center;
  padding: 8px 12px; border-bottom: 1px solid var(--line);
}
.h-meta { grid-column: 1 / 2; font-size: 11px; color: var(--muted); }
.h-expr {
  grid-column: 1 / 2; min-width: 0; text-align: left; border: 0; background: transparent; color: inherit;
  padding: 2px 0; cursor: pointer; overflow-x: auto; white-space: nowrap;
  font-family: "Cambria Math", "Times New Roman", serif; font-size: 17px;
}
.h-res {
  grid-column: 1 / 2; min-width: 0; text-align: right; border: 0; background: transparent; color: var(--accent);
  padding: 2px 0; cursor: pointer; font-size: 19px; font-weight: 800; overflow-x: auto; white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.h-del {
  grid-column: 2 / 3; grid-row: 1 / 4; align-self: center;
  width: 30px; height: 30px; border-radius: 15px; border: 1px solid var(--line);
  background: transparent; color: var(--muted); font-size: 16px; cursor: pointer;
}
.h-empty { padding: 24px 16px; color: var(--muted); font-size: 14px; line-height: 1.7; }
.h-empty code { background: var(--line); color: var(--panel-fg); padding: 1px 5px; border-radius: 4px; font-size: 13px; }
.h-tip { flex: none; padding: 6px 12px 10px; font-size: 11.5px; color: var(--muted); border-top: 1px solid var(--line); line-height: 1.5; }

/* 휴대폰 화면용: 기록은 아래에서 올라오는 창 */
.backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 20; }
@media (max-width: 759.98px) {
  .history {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    height: 82dvh; max-height: 82vh;
    border-radius: 18px 18px 0 0;
    padding-bottom: env(safe-area-inset-bottom);
    transform: translateY(105%); transition: transform .25s ease;
    visibility: hidden;
  }
  .history.open { transform: translateY(0); visibility: visible; }
  .backdrop.open { display: block; }
  .h-close { display: inline-block; }
  .calc { max-width: 560px; }
}
/* 넓은 화면용: 나란히 보기 */
@media (min-width: 760px) {
  #btnHistory { display: none; }
  .history { flex: 0 1 380px; width: 380px; }
  .layout { padding: 0 16px 16px; }
}
/* 노트북 큰 화면: 키 글자 조금 크게 */
@media (min-width: 1100px) {
  .history { flex-basis: 440px; width: 440px; }
}

/* 세로가 짧은 휴대폰(아이폰 SE 등): 화면 영역을 조금 줄임 */
@media (max-height: 700px) {
  .topbar { height: 42px; }
  .layout { height: calc(100dvh - 42px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); }
  .editor { min-height: 60px; font-size: 23px; }
  .result { min-height: 34px; font-size: 26px; }
  .keys { gap: 5px; grid-template-rows: 30px repeat(3, minmax(31px, 1fr)) minmax(34px, 1.1fr) minmax(31px, .85fr) repeat(4, minmax(36px, 1.25fr)); }
  .k-num { font-size: 20px; }
}
/* 아주 낮은 화면(세로 600px 이하, 예: 작은 휴대폰): 한 화면에 다 들어오게 더 줄임 */
@media (max-height: 600px) {
  .topbar { height: 38px; }
  .layout { height: calc(100dvh - 38px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); min-height: 480px; padding-bottom: 6px; }
  .display { padding: 4px 10px 6px; }
  .disp-top { min-height: 18px; }
  .editor { min-height: 54px; font-size: 22px; padding: 3px 2px; }
  /* 버튼이 낮으므로 첨자 위치를 조금만 덜 올리고 내림 (버튼 밖으로 안 나가게) */
  .key sup { top: -.8em; }
  .key sub { top: .55em; }
  .key .kl:has(sub) { transform: translateY(-.15em); }
  .result { min-height: 30px; font-size: 24px; }
  .keys { gap: 4px; grid-template-rows: 28px repeat(3, minmax(29px, 1fr)) minmax(32px, 1.1fr) minmax(29px, .85fr) repeat(4, minmax(34px, 1.25fr)); }
}
/* 아주 좁은 화면(폭 340px 이하) */
@media (max-width: 340px) {
  .k-fn { font-size: 14px; }
  .k-small { font-size: 12.5px !important; }
  .k-tiny { font-size: 11.5px !important; }
  .keys { gap: 5px; }
  .topbar h1 { font-size: 16px; }
  .top-btn { padding: 0 9px; font-size: 13px; }
}

/* =========================================================
   8. 테마 선택 창, 알림 메시지
   ========================================================= */
