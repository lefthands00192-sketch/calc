<script>
"use strict";
/* =====================================================================
   0. 화면 요소 찾아두기
   ===================================================================== */
const $ = (id) => document.getElementById(id);
const editorEl = $("editor");    // 교과서 모양 수식 입력칸
const resultEl = $("result");    // 결과 줄
const keysEl   = $("keys");      // 키패드 격자
const tabsEl   = $("tabs");      // 탭 줄
const hListEl  = $("hList");     // 기록 목록

/* 터치 화면(휴대폰, 태블릿)인지 확인 → 터치 화면이면 자판이 안 뜨게 함 */
const IS_TOUCH = window.matchMedia("(pointer: coarse)").matches;

/* 계산기 상태 */
const state = {
  deg: true,            // true: 각도를 도(DEG)로, false: 라디안(RAD)
  ans: 0,               // 직전 계산 결과 (Ans)
  justEvaluated: false, // 방금 = 을 눌렀는지
  tab: "basic",         // 지금 보고 있는 함수 탭
  nativeKbd: false,     // 휴대폰 자판 사용 여부
};
const history = [];     // 계산 기록 (새로고침 전까지 누적)
let historyNo = 0;      // 기록 번호

/* =====================================================================
   1. 수식 읽기 (토큰 나누기)
   - "2sin(30)+√(4)" 같은 글자를 숫자, 기호, 함수 이름 조각으로 나눔
   ===================================================================== */
class CalcError extends Error {}   // 학생에게 보여줄 오류 메시지용

// 함수 이름 목록 (소문자로 비교) → 실제 이름
const FUNC_NAMES = {
  asinh:"asinh", acosh:"acosh", atanh:"atanh", sinh:"sinh", cosh:"cosh", tanh:"tanh",
  asin:"asin", acos:"acos", atan:"atan", sin:"sin", cos:"cos", tan:"tan",
  sqrt:"sqrt", cbrt:"cbrt", root:"root", log:"log", ln:"ln", exp:"exp", abs:"abs",
  floor:"floor", ceil:"ceil", round:"round", npr:"nPr", ncr:"nCr", mod:"mod",
  gcd:"gcd", lcm:"lcm", max:"max", min:"min", mean:"mean", rand:"rand",
};
// 글자 이름들을 긴 것부터 맞춰보기 위해 정렬 (예: "sinh"를 "sin"+"h"로 잘못 읽지 않도록)
const WORDS = Object.keys(FUNC_NAMES).concat(["ans", "pi", "e"]).sort((a, b) => b.length - a.length);

function tokenize(src) {
  const tokens = [];
  let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (/\s/.test(c)) { i++; continue; }                       // 빈칸은 무시

    // --- 숫자 (예: 12, 3.5, .5, 3.) ---
    if (/[0-9.]/.test(c)) {
      const m = src.slice(i).match(/^(\d+\.?\d*|\.\d*)/)[0];
      if (src[i + m.length] === ".") throw new CalcError("소수점이 두 번 들어갔어요");
      if (m === ".") throw new CalcError("소수점 앞뒤에 숫자를 넣어 주세요");
      tokens.push({ type: "num", value: parseFloat(m), text: m });
      i += m.length; continue;
    }
    // --- 위첨자 ², ³ 는 ^2, ^3 으로 바꿔 읽기 ---
    if (c === "²" || c === "³") {
      tokens.push({ type: "op", v: "^" });
      tokens.push({ type: "num", value: c === "²" ? 2 : 3, text: c === "²" ? "2" : "3" });
      i++; continue;
    }
    // --- 기호들 ---
    if (c === "+") { tokens.push({ type: "op", v: "+" }); i++; continue; }
    if (c === "-" || c === "−" || c === "–") { tokens.push({ type: "op", v: "-" }); i++; continue; }
    if (c === "*" || c === "×" || c === "·") { tokens.push({ type: "op", v: "×" }); i++; continue; }
    if (c === "/" || c === "÷") { tokens.push({ type: "op", v: "÷" }); i++; continue; }
    if (c === "^") { tokens.push({ type: "op", v: "^" }); i++; continue; }
    if (c === "!") { tokens.push({ type: "op", v: "!" }); i++; continue; }
    if (c === "%") { tokens.push({ type: "op", v: "%" }); i++; continue; }
    if (c === "(" || c === "[") { tokens.push({ type: "(" }); i++; continue; }
    if (c === ")" || c === "]") { tokens.push({ type: ")" }); i++; continue; }
    if (c === ",") { tokens.push({ type: "," }); i++; continue; }
    if (c === "√") { tokens.push({ type: "func", name: "sqrt" }); i++; continue; }
    if (c === "∛") { tokens.push({ type: "func", name: "cbrt" }); i++; continue; }
    if (c === "π") { tokens.push({ type: "const", name: "pi" }); i++; continue; }
    if (c === "□") { tokens.push({ type: "ph" }); i++; continue; }        // 아직 안 채운 빈칸

    // --- 영어 글자: 함수 이름, Ans, pi, e ---
    if (/[A-Za-z]/.test(c)) {
      const run = src.slice(i).match(/^[A-Za-z]+/)[0];
      let j = 0;
      while (j < run.length) {
        const rest = run.slice(j).toLowerCase();
        const w = WORDS.find((word) => rest.startsWith(word));
        if (!w) throw new CalcError(`알 수 없는 글자 '${run[j]}' 가 있어요`);
        if (w === "ans") tokens.push({ type: "ans" });
        else if (w === "pi") tokens.push({ type: "const", name: "pi" });
        else if (w === "e") tokens.push({ type: "const", name: "e" });
        else tokens.push({ type: "func", name: FUNC_NAMES[w] });
        j += w.length;
      }
      i += run.length; continue;
    }
    throw new CalcError(`사용할 수 없는 기호 '${c}' 가 있어요`);
  }
  return tokens;
}

/* =====================================================================
   2. 수식 구조 만들기 (파서)
   - 계산 순서: 괄호 → 함수 → 거듭제곱 → 부호 → 곱셈·나눗셈 → 덧셈·뺄셈
   - 2π, 3sin(30), 2(3+4) 처럼 곱하기 기호를 생략해도 곱셈으로 처리
   - 닫는 괄호를 빼먹어도 끝에서 자동으로 닫아줌
   - lenient(너그러운 모드): 아직 덜 쓴 식도 미리보기용으로 빈칸(□)을 넣어 만들어 줌
   ===================================================================== */
class Parser {
  constructor(tokens, lenient) { this.t = tokens; this.p = 0; this.lenient = lenient; }
  peek() { return this.t[this.p]; }
  next() { return this.t[this.p++]; }
  isOp(v) { const k = this.peek(); return k && k.type === "op" && k.v === v; }

  // 전체 식 읽기
  parseAll() {
    if (this.t.length === 0) {
      if (this.lenient) return { type: "ph" };
      throw new CalcError("수식을 입력해 주세요");
    }
    const node = this.parseAdd();
    if (this.p < this.t.length) {
      const k = this.peek();
      if (k.type === ")") throw new CalcError("여는 괄호 없이 닫는 괄호 ')' 가 있어요");
      if (k.type === ",") throw new CalcError("쉼표(,)는 함수 괄호 안에서만 써요");
      throw new CalcError("수식 모양이 올바르지 않아요");
    }
    return node;
  }
  // 덧셈, 뺄셈
  parseAdd() {
    let left = this.parseMul();
    while (this.isOp("+") || this.isOp("-")) {
      const op = this.next().v;
      left = { type: "bin", op, l: left, r: this.parseMul() };
    }
    return left;
  }
  // 곱셈, 나눗셈, 생략된 곱셈
  parseMul() {
    let left = this.parseUnary();
    for (;;) {
      if (this.isOp("×") || this.isOp("÷")) {
        const op = this.next().v;
        left = { type: "bin", op, l: left, r: this.parseUnary() };
      } else if (this.startsValue(this.peek())) {
        // 2π, 3(4+5) 처럼 기호 없이 붙어 있으면 곱셈
        left = { type: "bin", op: "imp", l: left, r: this.parseUnary() };
      } else break;
    }
    return left;
  }
  // 바로 값이 시작되는 조각인지 (생략된 곱셈 판단용)
  startsValue(k) {
    return !!k && (k.type === "num" || k.type === "const" || k.type === "ans" || k.type === "func" || k.type === "(" || k.type === "ph");
  }
  // 음수 부호 (-2^2 = -4 가 되도록 거듭제곱보다 나중에 계산)
  parseUnary() {
    if (this.isOp("-")) { this.next(); return { type: "neg", a: this.parseUnary() }; }
    if (this.isOp("+")) { this.next(); return this.parseUnary(); }
    return this.parsePow();
  }
  // 거듭제곱 (오른쪽부터 계산: 2^3^2 = 2^9)
  parsePow() {
    const base = this.parsePostfix();
    if (this.isOp("^")) { this.next(); return { type: "pow", b: base, e: this.parseUnary() }; }
    return base;
  }
  // 뒤에 붙는 기호: 계승(!), 퍼센트(%)
  parsePostfix() {
    let node = this.parsePrimary();
    while (this.isOp("!") || this.isOp("%")) {
      node = { type: this.next().v === "!" ? "fact" : "pct", a: node };
    }
    return node;
  }
  // 가장 작은 단위: 숫자, 상수, 괄호, 함수
  parsePrimary() {
    const k = this.peek();
    if (!k || k.type === ")" || k.type === "," || (k.type === "op" && !["-", "+"].includes(k.v))) {
      // 값이 와야 할 자리가 비어 있음
      if (this.lenient) return { type: "ph" };
      if (!k) throw new CalcError("수식을 끝까지 입력해 주세요");
      if (k.type === ")") throw new CalcError("괄호 안이 비어 있어요");
      if (k.type === ",") throw new CalcError("빈칸이 있어요. 값을 넣어 주세요");
      throw new CalcError(`'${k.v}' 앞에 값이 필요해요`);
    }
    if (k.type === "op") return this.parseUnary();   // 2×-3 같은 경우
    this.next();
    if (k.type === "ph") return { type: "ph" };
    if (k.type === "num") return { type: "num", v: k.value, text: k.text };
    if (k.type === "const") return { type: "const", name: k.name };
    if (k.type === "ans") return { type: "ans" };
    if (k.type === "(") {
      const inner = this.parseAdd();
      const closed = this.closeParen();
      return { type: "group", a: inner, closed };
    }
    if (k.type === "func") {
      // 괄호 없이 쓴 경우: sin30, √4
      if (!this.peek() || this.peek().type !== "(") {
        return { type: "func", name: k.name, args: [this.parseUnary()], closed: true, noParen: true };
      }
      this.next(); // "(" 건너뛰기
      const args = [];
      if (this.peek() && this.peek().type === ")") {
        this.next();
        return { type: "func", name: k.name, args, closed: true };
      }
      if (!this.peek()) {          // "sin(" 까지만 쓴 상태
        if (this.lenient) return { type: "func", name: k.name, args: [{ type: "ph" }], closed: false };
        throw new CalcError("수식을 끝까지 입력해 주세요");
      }
      args.push(this.parseAdd());
      while (this.peek() && this.peek().type === ",") { this.next(); args.push(this.parseAdd()); }
      const closed = this.closeParen();
      return { type: "func", name: k.name, args, closed };
    }
    throw new CalcError("수식 모양이 올바르지 않아요");
  }
  // 닫는 괄호: 끝까지 없으면 자동으로 닫힌 것으로 봄
  closeParen() {
    const k = this.peek();
    if (k && k.type === ")") { this.next(); return true; }
    if (!k) return false;
    if (k.type === ",") throw new CalcError("쉼표(,)는 함수 괄호 안에서만 써요");
    throw new CalcError("괄호가 맞지 않아요");
  }
}

/* =====================================================================
   3. 계산하기
   ===================================================================== */
const DEG = Math.PI / 180;

// 계승 n! (정수가 아니면 감마함수로 계산)
function factorial(n) {
  if (Number.isInteger(n)) {
    if (n < 0) throw new CalcError("음의 정수는 계승(!)을 계산할 수 없어요");
    if (n > 170) throw new CalcError("값이 너무 커서 계산할 수 없어요");
    let r = 1; for (let i = 2; i <= n; i++) r *= i; return r;
  }
  return gamma(n + 1);
}
// 감마함수 (Lanczos 근사)
function gamma(z) {
  if (z < 0.5) return Math.PI / (Math.sin(Math.PI * z) * gamma(1 - z));
  const g = 7, c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313,
    -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
  z -= 1; let x = c[0];
  for (let i = 1; i < g + 2; i++) x += c[i] / (z + i);
  const t = z + g + 0.5;
  return Math.sqrt(2 * Math.PI) * Math.pow(t, z + 0.5) * Math.exp(-t) * x;
}
// 0 이상 정수인지 검사
function needInt(x, what) {
  if (!Number.isInteger(x) || x < 0) throw new CalcError(`${what}에는 0 이상의 정수를 넣어 주세요`);
}
function gcd2(a, b) { a = Math.abs(a); b = Math.abs(b); while (b) [a, b] = [b, a % b]; return a; }

// 삼각함수: DEG 모드에서 sin(180)=0 처럼 딱 떨어지는 각은 정확하게
function trig(name, x, deg) {
  if (deg) {
    const r = ((x % 360) + 360) % 360;
    if (Number.isInteger(r) || Math.abs(r - Math.round(r)) < 1e-12) {
      const R = Math.round(r) % 360;
      if (name === "sin") { if (R % 180 === 0) return 0; if (R === 90) return 1; if (R === 270) return -1; if (R === 30 || R === 150) return 0.5; if (R === 210 || R === 330) return -0.5; }
      if (name === "cos") { if (R === 90 || R === 270) return 0; if (R === 0) return 1; if (R === 180) return -1; if (R === 60 || R === 300) return 0.5; if (R === 120 || R === 240) return -0.5; }
      if (name === "tan") { if (R % 180 === 0) return 0; if (R % 180 === 90) throw new CalcError("tan 90° 는 정의되지 않아요"); if (R === 45 || R === 225) return 1; if (R === 135 || R === 315) return -1; }
    }
    x *= DEG;
  }
  let v = Math[name](x);
  if (Math.abs(v) < 1e-15) v = 0;   // sin(π) = 0.0000000000000001 같은 오차 없애기
  return v;
}

// 함수별 (최소, 최대) 인자 개수
const ARITY = {
  sin:[1,1], cos:[1,1], tan:[1,1], asin:[1,1], acos:[1,1], atan:[1,1],
  sinh:[1,1], cosh:[1,1], tanh:[1,1], asinh:[1,1], acosh:[1,1], atanh:[1,1],
  sqrt:[1,1], cbrt:[1,1], root:[2,2], log:[1,2], ln:[1,1], exp:[1,1], abs:[1,1],
  floor:[1,1], ceil:[1,1], round:[1,2], nPr:[2,2], nCr:[2,2], mod:[2,2],
  gcd:[2,99], lcm:[2,99], max:[1,99], min:[1,99], mean:[1,99], rand:[0,0],
};
// 사람이 읽기 좋은 함수 이름 (오류 메시지용)
const NICE = { asin:"sin⁻¹", acos:"cos⁻¹", atan:"tan⁻¹", asinh:"sinh⁻¹", acosh:"cosh⁻¹", atanh:"tanh⁻¹", sqrt:"√", cbrt:"∛", root:"거듭제곱근" };

function evaluate(node, ctx) {
  switch (node.type) {
    case "num": return node.v;
    case "const": return node.name === "pi" ? Math.PI : Math.E;
    case "ans": return ctx.ans;
    case "ph": throw new CalcError("빈칸(□)을 채워 주세요");
    case "group": return evaluate(node.a, ctx);
    case "neg": return -evaluate(node.a, ctx);
    case "pct": return evaluate(node.a, ctx) / 100;
    case "fact": return factorial(evaluate(node.a, ctx));
    case "pow": {
      const b = evaluate(node.b, ctx), e = evaluate(node.e, ctx);
      if (b === 0 && e < 0) throw new CalcError("0으로 나눌 수 없어요");
      // 음수의 홀수분의 1 거듭제곱: (-8)^(1/3) = -2
      if (b < 0 && !Number.isInteger(e)) {
        const inv = 1 / e;
        if (Math.abs(inv - Math.round(inv)) < 1e-9 && Math.round(inv) % 2 !== 0) return -Math.pow(-b, e);
        throw new CalcError("음수의 이 거듭제곱은 실수 범위에서 계산할 수 없어요");
      }
      return Math.pow(b, e);
    }
    case "bin": {
      const l = evaluate(node.l, ctx), r = evaluate(node.r, ctx);
      if (node.op === "+") return l + r;
      if (node.op === "-") return l - r;
      if (node.op === "×" || node.op === "imp") return l * r;
      if (node.op === "÷") { if (r === 0) throw new CalcError("0으로 나눌 수 없어요"); return l / r; }
      break;
    }
    case "func": return evalFunc(node, ctx);
  }
  throw new CalcError("계산할 수 없는 식이에요");
}

function evalFunc(node, ctx) {
  const f = node.name, [lo, hi] = ARITY[f];
  const nice = NICE[f] || f;
  if (node.args.length < lo || node.args.length > hi) {
    if (lo === hi) throw new CalcError(`${nice} 에는 값을 ${lo}개 넣어요` + (lo === 2 ? " (쉼표로 구분)" : ""));
    throw new CalcError(`${nice} 에 넣은 값의 개수가 맞지 않아요`);
  }
  const a = node.args.map((n) => evaluate(n, ctx));
  const x = a[0];
  const deg = ctx.deg;
  const domain = () => { throw new CalcError(`${nice} 에 넣을 수 없는 값이에요 (정의역 확인)`); };
  switch (f) {
    case "sin": case "cos": case "tan": return trig(f, x, deg);
    case "asin": case "acos": if (x < -1 || x > 1) domain(); return deg ? Math[f](x) / DEG : Math[f](x);
    case "atan": return deg ? Math.atan(x) / DEG : Math.atan(x);
    case "sinh": case "cosh": case "tanh": case "asinh": return Math[f](x);
    case "acosh": if (x < 1) domain(); return Math.acosh(x);
    case "atanh": if (x <= -1 || x >= 1) domain(); return Math.atanh(x);
    case "sqrt": if (x < 0) throw new CalcError("음수의 제곱근은 실수 범위에서 계산할 수 없어요"); return Math.sqrt(x);
    case "cbrt": return Math.cbrt(x);
    case "root": {                                  // root(n, x) = x 의 n제곱근
      const n = a[0], v = a[1];
      if (n === 0) throw new CalcError("0제곱근은 계산할 수 없어요");
      if (v < 0) {
        if (Number.isInteger(n) && Math.abs(n) % 2 === 1) return -Math.pow(-v, 1 / n);
        throw new CalcError("음수의 짝수 제곱근은 실수 범위에서 계산할 수 없어요");
      }
      return Math.pow(v, 1 / n);
    }
    case "log": {
      if (a.length === 1) { if (x <= 0) throw new CalcError("log 안에는 0보다 큰 수를 넣어요"); return Math.log10(x); }
      const b = a[0], v = a[1];                   // log(밑, 진수)
      if (b <= 0 || b === 1) throw new CalcError("로그의 밑은 0보다 크고 1이 아닌 수여야 해요");
      if (v <= 0) throw new CalcError("로그의 진수는 0보다 커야 해요");
      return Math.log(v) / Math.log(b);
    }
    case "ln": if (x <= 0) throw new CalcError("ln 안에는 0보다 큰 수를 넣어요"); return Math.log(x);
    case "exp": return Math.exp(x);
    case "abs": return Math.abs(x);
    case "floor": return Math.floor(x);
    case "ceil": return Math.ceil(x);
    case "round": {
      const d = a.length > 1 ? a[1] : 0; needInt(d, "반올림 자릿수");
      const p = Math.pow(10, d); return Math.round((x + Math.sign(x) * 1e-12) * p) / p;
    }
    case "nPr": case "nCr": {
      const n = a[0], r = a[1];
      needInt(n, f); needInt(r, f);
      if (r > n) throw new CalcError(`${f} 에서는 r이 n보다 클 수 없어요`);
      let v = 1;
      if (f === "nPr") { for (let i = 0; i < r; i++) v *= (n - i); }
      else { const k = Math.min(r, n - r); for (let i = 1; i <= k; i++) v = v * (n - k + i) / i; v = Math.round(v); }
      return v;
    }
    case "mod": { if (a[1] === 0) throw new CalcError("0으로 나눌 수 없어요"); return ((a[0] % a[1]) + a[1]) % a[1]; }
    case "gcd": a.forEach((v) => needInt(Math.abs(v), "gcd")); return a.reduce(gcd2);
    case "lcm": a.forEach((v) => needInt(Math.abs(v), "lcm")); return a.reduce((p, q) => (p === 0 || q === 0) ? 0 : Math.abs(p * q) / gcd2(p, q));
    case "max": return Math.max(...a);
    case "min": return Math.min(...a);
    case "mean": return a.reduce((s, v) => s + v, 0) / a.length;
    case "rand": return Math.random();
  }
  throw new CalcError("알 수 없는 함수예요");
}

/* 문자열 수식 → 숫자 (오류면 CalcError) */
function calculate(src) {
  const tree = new Parser(tokenize(src), false).parseAll();
  const v = evaluate(tree, { deg: state.deg, ans: state.ans });
  if (Number.isNaN(v)) throw new CalcError("정의되지 않는 계산이에요");
  if (!Number.isFinite(v)) throw new CalcError("값이 너무 커서 계산할 수 없어요");
  return v;
}

/* =====================================================================
   4. 결과 숫자 보기 좋게 만들기
   - 12자리로 반올림해서 0.1+0.2 = 0.30000000000000004 같은 오차 없애기
   - 아주 크거나 작은 수는 1.23×10^15 처럼 표시
   ===================================================================== */
function cleanNumber(x) { return Number(x.toPrecision(12)); }

function formatNumber(x) {
  const v = cleanNumber(x);
  if (v === 0) return { html: "0", plain: "0", insert: "0" };
  const exp = Math.floor(Math.log10(Math.abs(v)));
  if (exp >= 12 || exp < -6) {
    // 과학적 표기
    let m = v / Math.pow(10, exp);
    let mStr = String(Number(m.toPrecision(10)));
    let e = exp;
    if (Math.abs(Number(mStr)) >= 10) { mStr = String(Number((Number(mStr) / 10).toPrecision(10))); e += 1; }
    return {
      html: `${mStr.replace("-", "−")}<span class="m-sci">×10<span class="m-sup">${String(e).replace("-", "−")}</span></span>`,
      plain: `${mStr}×10^${e}`,
      insert: `(${mStr}×10^(${e}))`,
    };
  }
  let s = String(v);
  if (/e/.test(s)) s = v.toFixed(12).replace(/\.?0+$/, "");
  return { html: s.replace("-", "−"), plain: s, insert: v < 0 ? `(${s})` : s };
}

/* 분수로 바꿀 수 있으면 분수로 (예: 0.75 → 3/4) */
function toFraction(x) {
  const v = cleanNumber(x);
  if (!Number.isFinite(v) || Number.isInteger(v) || Math.abs(v) >= 1e7) return null;
  let h1 = 1, h0 = 0, k1 = 0, k0 = 1, b = Math.abs(v);
  for (let i = 0; i < 30; i++) {                // 연분수로 근사
    const a = Math.floor(b);
    [h1, h0] = [a * h1 + h0, h1];
    [k1, k0] = [a * k1 + k0, k1];
    if (k1 > 1000) return null;
    if (Math.abs(Math.abs(v) - h1 / k1) < 1e-10 * Math.max(1, Math.abs(v))) {
      return k1 === 1 ? null : { n: (v < 0 ? -1 : 1) * h1, d: k1 };
    }
    b = 1 / (b - a);
    if (!Number.isFinite(b)) break;
  }
  return null;
}

function esc(s) { return String(s).replace(/[&<>"']/g, (c) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c])); }

/* =====================================================================
   5. 교과서 모양 수식 입력기
   - 수식을 "줄(row)" 과 "상자(node)" 로 저장
     · 줄: 항목들의 배열 (숫자, 기호, 상자)
     · 상자: 분수, 지수, 루트, 괄호, 함수 등. 상자 안에는 빈칸(줄)이 1~2개 있음
       예) 분수 = { t:"frac", num:[...], den:[...] }
   - 커서는 "어느 줄의 몇 번째 자리" 로 기억
   - 계산할 때는 줄을 글자 수식 "((1+2)÷(3+4))" 로 바꿔서 위의 계산기에 넘김
   ===================================================================== */

// 상자 종류별 빈칸 이름 (순서 = 커서가 지나가는 순서)
const SLOTS = {
  frac: ["num", "den"],     // 분수: 분자, 분모
  pow: ["exp"],             // 지수 (앞에 있는 것의 거듭제곱)
  sqrt: ["body"],           // 제곱근
  root: ["idx", "body"],    // 거듭제곱근: 차수, 안쪽
  par: ["body"],            // 괄호
  func: ["body"],           // 함수 하나짜리: sin( ), log( ) 등
  func2: ["a", "b"],        // 값 두 개 함수: mod(a, b), gcd(a, b)
  logb: ["base", "arg"],    // 밑이 있는 로그
  ncr: ["n", "r"],          // 조합
  npr: ["n", "r"],          // 순열
  abs: ["body"],            // 절댓값
};

// 새 빈 줄 만들기 (parent: 이 줄을 품고 있는 상자 정보)
function mkRow(parent) { const r = []; r.parent = parent || null; return r; }
// 글자 하나짜리 항목
function mkChar(v) { return { t: "c", v }; }
// 상자 만들기 (빈칸 줄들을 함께 만듦)
function mkNode(t, props) {
  const n = Object.assign({ t }, props || {});
  SLOTS[t].forEach((k) => { n[k] = mkRow({ node: n, key: k }); });
  return n;
}
function isNode(it) { return !!SLOTS[it.t]; }
function slotRows(n) { return SLOTS[n.t].map((k) => n[k]); }
// 항목을 줄에 넣을 때, 그 항목이 어느 줄에 있는지 기록 (커서 이동에 필요)
function placeItems(row, items, at) {
  row.splice(at, 0, ...items);
  items.forEach((it) => { it.ownerRow = row; });
}
// 줄에 글자들 채우기 (예: 지수 "2")
function fillChars(row, text) { placeItems(row, [...text].map(mkChar), row.length); }

// 줄 깊은 복사 (기록 저장, 기록 불러오기용)
function cloneRow(row, parent) {
  const nr = mkRow(parent);
  row.forEach((it) => {
    let c;
    if (isNode(it)) {
      c = Object.assign({}, it);
      SLOTS[it.t].forEach((k) => { c[k] = cloneRow(it[k], { node: c, key: k }); });
    } else c = { t: "c", v: it.v };
    c.ownerRow = nr;
    nr.push(c);
  });
  return nr;
}

/* ----- 입력기 상태 ----- */
let root = mkRow(null);              // 맨 바깥 줄
let cur = { row: root, idx: 0 };     // 커서 위치

/* ---------------------------------------------------------------------
   5-1. 글자 수식으로 바꾸기 (계산용)
   --------------------------------------------------------------------- */
const OPERATOR_CHARS = ["+", "-", "×", "÷", ","];
function serialize(row) {
  if (row.length === 0) return "□";                  // 빈칸은 □ 로 → "빈칸을 채워 주세요"
  let s = "";
  row.forEach((it, i) => {
    if (!isNode(it)) { s += it.v; return; }
    const S = (k) => serialize(it[k]);
    switch (it.t) {
      case "frac": s += `((${S("num")})÷(${S("den")}))`; break;
      case "pow": {
        // 지수 앞에 밑이 없으면 빈칸
        const prev = row[i - 1];
        if (!prev || (!isNode(prev) && OPERATOR_CHARS.includes(prev.v))) s += "□";
        s += `^(${S("exp")})`; break;
      }
      case "sqrt": s += `√(${S("body")})`; break;
      case "root": s += `root(${S("idx")},${S("body")})`; break;
      case "par": s += `(${S("body")})`; break;
      case "func": s += `${it.name}(${it.body.length ? serialize(it.body) : (it.name === "rand" ? "" : "□")})`; break;
      case "func2": s += `${it.name}(${S("a")},${S("b")})`; break;
      case "logb": s += `log(${S("base")},${S("arg")})`; break;
      case "ncr": s += `nCr(${S("n")},${S("r")})`; break;
      case "npr": s += `nPr(${S("n")},${S("r")})`; break;
      case "abs": s += `abs(${S("body")})`; break;
    }
  });
  return s;
}

/* ---------------------------------------------------------------------
   5-2. 화면에 그리기
   - 편집용: 항목마다 data-rid(줄 번호), data-i(자리) 를 달아서 눌러서 커서를 옮길 수 있게
   - 기록용(static): 번호와 커서 없이 모양만
   --------------------------------------------------------------------- */
let rowRegistry = [];      // data-rid 번호 → 줄
let staticMode = false;    // true 면 기록용 그리기
const CURSOR = '<span class="cur"></span>';
const SVG_SQRT = '<svg class="sign" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0,62 L22,52 L50,98 L100,1"/></svg>';
const SVG_LP = '<svg class="pl" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M85,2 Q5,50 85,98"/></svg>';
const SVG_RP = '<svg class="pr" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M15,2 Q95,50 15,98"/></svg>';
// 함수 이름을 보기 좋게
const FUNC_LABEL = {
  asin: "sin<span class='m-sup'>−1</span>", acos: "cos<span class='m-sup'>−1</span>", atan: "tan<span class='m-sup'>−1</span>",
  asinh: "sinh<span class='m-sup'>−1</span>", acosh: "cosh<span class='m-sup'>−1</span>", atanh: "tanh<span class='m-sup'>−1</span>",
  mean: "평균", round: "반올림", floor: "내림", ceil: "올림", rand: "난수",
};

function renderRow(row) {
  const rid = staticMode ? -1 : rowRegistry.push(row) - 1;
  const ridAttr = staticMode ? "" : ` data-rid="${rid}"`;
  const here = !staticMode && cur.row === row;
  if (row.length === 0) {
    // 빈칸: 커서가 들어와 있으면 강조
    return `<span class="row"${ridAttr}><span class="m-ph${here ? " on" : ""}">${here ? CURSOR : ""}</span></span>`;
  }
  let html = "";
  row.forEach((it, i) => {
    if (here && cur.idx === i) html += CURSOR;
    html += renderItem(it, rid, i, row);
  });
  if (here && cur.idx === row.length) html += CURSOR;
  return `<span class="row"${ridAttr}>${html}</span>`;
}

function renderItem(it, rid, i, row) {
  const a = staticMode ? "" : ` data-rid="${rid}" data-i="${i}"`;
  const R = (k) => renderRow(it[k]);
  if (!isNode(it)) {
    const v = it.v;
    if (v === "+" || v === "-" || v === "×" || v === "÷") {
      // 맨 앞이나 다른 기호 바로 뒤의 - 는 음수 부호라서 띄어 쓰지 않음
      const prev = row[i - 1];
      const unary = v === "-" && (!prev || (!isNode(prev) && ["+", "-", "×", "÷", ","].includes(prev.v)));
      const sym = { "+": "+", "-": "−", "×": "×", "÷": "÷" }[v];
      return unary ? `<span${a}>−</span>` : `<span class="m-op"${a}>${sym}</span>`;
    }
    if (v === ",") return `<span class="m-comma"${a}>,</span>`;
    if (v === "e") return `<span class="m-e"${a}>e</span>`;
    if (v === "Ans") return `<span class="m-ans"${a}>Ans</span>`;
    if (/^[A-Za-z]$/.test(v)) return `<span class="m-let"${a}>${v}</span>`;   // 함수 이름을 치는 중인 글자
    return `<span${a}>${esc(v)}</span>`;
  }
  switch (it.t) {
    case "frac": return `<span class="m-frac"${a}><span class="fn">${R("num")}</span><span class="fd">${R("den")}</span></span>`;
    case "pow": {
      const prev = row[i - 1];
      const noBase = !prev || (!isNode(prev) && ["+", "-", "×", "÷", ","].includes(prev.v));
      return `${noBase ? '<span class="m-ph"></span>' : ""}<span class="m-sup"${a}>${R("exp")}</span>`;
    }
    case "sqrt": return `<span class="m-sqrt"${a}>${SVG_SQRT}<span class="body">${R("body")}</span></span>`;
    case "root": return `<span class="m-sqrt has-idx"${a}><span class="idx">${R("idx")}</span>${SVG_SQRT}<span class="body">${R("body")}</span></span>`;
    case "par": {
      // 분자·분모·지수 안에 괄호 하나만 있으면 괄호를 그리지 않음 (분수 선이 괄호 역할)
      // 단, 커서가 그 괄호 안에 있을 때는 보여 줘서 지금 괄호 안을 쓰고 있다는 걸 알게 함
      const pn = row.parent && row.parent.node;
      if (row.length === 1 && pn && (pn.t === "frac" || pn.t === "pow") && it.body.length && !cursorInside(it)) {
        return `<span${a}>${R("body")}</span>`;
      }
      return `<span class="m-par"${a}>${SVG_LP}${R("body")}${SVG_RP}</span>`;
    }
    case "func": {
      if (it.name === "rand") return `<span class="m-fn"${a}>난수</span>`;
      if (it.name === "exp") return `<span${a}><span class="m-e">e</span><span class="m-sup">${R("body")}</span></span>`;
      return `<span${a}><span class="m-fn">${FUNC_LABEL[it.name] || it.name}</span><span class="m-par">${SVG_LP}${R("body")}${SVG_RP}</span></span>`;
    }
    case "func2": return `<span${a}><span class="m-fn">${it.name}</span><span class="m-par">${SVG_LP}${R("a")}<span class="m-comma">,</span>${R("b")}${SVG_RP}</span></span>`;
    case "logb": return `<span${a}><span class="m-fn">log</span><span class="m-sub">${R("base")}</span><span class="m-par">${SVG_LP}${R("arg")}${SVG_RP}</span></span>`;
    case "ncr": case "npr":
      return `<span${a}><span class="m-sub">${R("n")}</span>${it.t === "ncr" ? "C" : "P"}<span class="m-sub">${R("r")}</span></span>`;
    case "abs": return `<span class="m-abs"${a}>${R("body")}</span>`;
  }
  return "";
}

// 커서가 이 상자 안에 있는지
function cursorInside(n) {
  if (staticMode) return false;
  let row = cur.row;
  while (row.parent) { if (row.parent.node === n) return true; row = row.parent.node.ownerRow; }
  return false;
}
// 기록 목록용: 커서 없이 모양만
function renderStatic(row) {
  staticMode = true;
  try { return renderRow(row); } finally { staticMode = false; }
}

/* ---------------------------------------------------------------------
   5-3. 커서 이동
   --------------------------------------------------------------------- */
// 상자 밖으로 나가기 (오른쪽): 다음 빈칸이 있으면 그리로, 없으면 상자 뒤로
function exitRight() {
  const p = cur.row.parent;
  if (!p) return false;
  const n = p.node, rows = slotRows(n), k = rows.indexOf(cur.row);
  if (k < rows.length - 1) cur = { row: rows[k + 1], idx: 0 };
  else cur = { row: n.ownerRow, idx: n.ownerRow.indexOf(n) + 1 };
  return true;
}
// 상자 밖으로 나가기 (왼쪽)
function exitLeft() {
  const p = cur.row.parent;
  if (!p) return false;
  const n = p.node, rows = slotRows(n), k = rows.indexOf(cur.row);
  if (k > 0) cur = { row: rows[k - 1], idx: rows[k - 1].length };
  else cur = { row: n.ownerRow, idx: n.ownerRow.indexOf(n) };
  return true;
}
function moveRight() {
  const it = cur.row[cur.idx];
  if (!it) return exitRight();
  if (isNode(it)) cur = { row: slotRows(it)[0], idx: 0 };   // 상자 안으로 들어가기
  else cur.idx++;
  return true;
}
function moveLeft() {
  const it = cur.row[cur.idx - 1];
  if (!it) return exitLeft();
  if (isNode(it)) { const rows = slotRows(it), last = rows[rows.length - 1]; cur = { row: last, idx: last.length }; }
  else cur.idx--;
  return true;
}
// 위/아래 (분수의 분자 ↔ 분모)
function moveVertical(dir) {
  let row = cur.row;
  while (row.parent) {
    const n = row.parent.node, k = row.parent.key;
    if (n.t === "frac" && ((dir > 0 && k === "num") || (dir < 0 && k === "den"))) {
      const target = dir > 0 ? n.den : n.num;
      cur = { row: target, idx: Math.min(cur.row === row ? cur.idx : target.length, target.length) };
      return true;
    }
    row = n.ownerRow;
  }
  return false;
}
// 지금 커서를 품고 있는 가장 안쪽 상자 밖으로 나가기
function exitNode() {
  const p = cur.row.parent;
  if (!p) return false;
  const n = p.node;
  cur = { row: n.ownerRow, idx: n.ownerRow.indexOf(n) + 1 };
  return true;
}
// ")" 키: 커서를 품은 괄호(또는 함수 괄호) 밖으로 나가기. 괄호가 없으면 가장 안쪽 상자 밖으로
const PAREN_TYPES = ["par", "func", "func2", "logb", "abs", "sqrt", "root"];   // 괄호로 닫히는 상자들
function exitParen() {
  let row = cur.row, target = null;
  while (row.parent) {
    const n = row.parent.node;
    if (PAREN_TYPES.includes(n.t) && !n.implicit) { target = n; break; }
    row = n.ownerRow;
  }
  if (!target) return exitNode();
  const owner = target.ownerRow, at = owner.indexOf(target);
  cur = { row: owner, idx: at + 1 };
  return true;
}
/* 키보드로 한 줄 수식을 칠 때: 1/2+1/3, 2^3+1, sin30+cos60 처럼
   분모·지수·괄호 없이 시작한 함수 끝에서 + − × ÷ , 를 치면 자동으로 밖으로 나옴
   (버튼으로 입력할 때는 빈칸이 눈에 보이므로 이 규칙을 쓰지 않음) */
function autoExitForTyping() {
  for (;;) {
    const p = cur.row.parent;
    if (!p || cur.idx !== cur.row.length || cur.row.length === 0) return;
    const n = p.node;
    const linear = (n.t === "frac" && p.key === "den") || n.t === "pow" || n.implicit;
    if (!linear) return;
    if (n.implicit) n.implicit = false;
    exitNode();
  }
}

/* ---------------------------------------------------------------------
   5-4. 넣기
   --------------------------------------------------------------------- */
function insertItems(items) { placeItems(cur.row, items, cur.idx); cur.idx += items.length; }
function insertChar(v) { insertItems([mkChar(v)]); }
// 상자를 넣고 커서를 첫 빈칸(또는 지정한 빈칸)으로
function insertNode(n, enterKey) {
  placeItems(cur.row, [n], cur.idx);
  const key = enterKey || SLOTS[n.t][0];
  cur = { row: n[key], idx: n[key].length };
}

// 분수 버튼: 커서 앞에 있는 수(또는 상자)를 분자로 가져가고 커서는 분모로
function isOperandItem(it) {
  if (!it) return false;
  if (isNode(it)) return true;
  return !["+", "-", "×", "÷", ","].includes(it.v);
}
function insertFraction() {
  const row = cur.row;
  let j = cur.idx;
  while (j > 0 && isOperandItem(row[j - 1])) j--;
  const taken = row.splice(j, cur.idx - j);
  const f = mkNode("frac");
  placeItems(f.num, taken, 0);
  placeItems(row, [f], j);
  cur = taken.length ? { row: f.den, idx: 0 } : { row: f.num, idx: 0 };
}
// 지수: exp 를 주면 채우고 커서는 상자 뒤에, 안 주면 지수 빈칸으로
function insertPower(exp) {
  const n = mkNode("pow");
  if (exp) {
    fillChars(n.exp, exp);
    placeItems(cur.row, [n], cur.idx);
    cur.idx++;
  } else insertNode(n);
}

// 함수 이름 글자들을 상자로 바꾸는 표 (키보드로 sin, sqrt, pi 등을 칠 때)
const NAME_TO_NODE = {
  sin: () => mkNode("func", { name: "sin" }), cos: () => mkNode("func", { name: "cos" }), tan: () => mkNode("func", { name: "tan" }),
  asin: () => mkNode("func", { name: "asin" }), acos: () => mkNode("func", { name: "acos" }), atan: () => mkNode("func", { name: "atan" }),
  sinh: () => mkNode("func", { name: "sinh" }), cosh: () => mkNode("func", { name: "cosh" }), tanh: () => mkNode("func", { name: "tanh" }),
  asinh: () => mkNode("func", { name: "asinh" }), acosh: () => mkNode("func", { name: "acosh" }), atanh: () => mkNode("func", { name: "atanh" }),
  log: () => mkNode("func", { name: "log" }), ln: () => mkNode("func", { name: "ln" }), exp: () => mkNode("func", { name: "exp" }),
  floor: () => mkNode("func", { name: "floor" }), ceil: () => mkNode("func", { name: "ceil" }), round: () => mkNode("func", { name: "round" }),
  max: () => mkNode("func", { name: "max" }), min: () => mkNode("func", { name: "min" }), mean: () => mkNode("func", { name: "mean" }),
  sqrt: () => mkNode("sqrt"), cbrt: () => { const n = mkNode("root"); fillChars(n.idx, "3"); return n; },
  abs: () => mkNode("abs"), mod: () => mkNode("func2", { name: "mod" }), gcd: () => mkNode("func2", { name: "gcd" }),
  lcm: () => mkNode("func2", { name: "lcm" }), ncr: () => mkNode("ncr"), npr: () => mkNode("npr"),
  pi: () => mkChar("π"), ans: () => mkChar("Ans"), rand: () => mkNode("func", { name: "rand" }),
};
const NAME_LIST = Object.keys(NAME_TO_NODE).sort((a, b) => b.length - a.length);
// 커서 앞에 연달아 있는 영어 글자들
function trailingLetters() {
  let s = "", j = cur.idx;
  while (j > 0) {
    const it = cur.row[j - 1];
    if (isNode(it) || !/^[A-Za-z]$/.test(it.v)) break;
    s = it.v + s; j--;
  }
  return s;
}
// 커서 앞 글자가 함수 이름으로 끝나면 상자로 바꾸기
// force=false: 더 긴 이름이 있을 수 있으면(sin → sinh) 기다림
function convertName(force) {
  const run = trailingLetters().toLowerCase();
  if (!run) return false;
  const name = NAME_LIST.find((nm) => run.endsWith(nm));
  if (!name) return false;
  if (!force && NAME_LIST.some((nm) => nm !== name && nm.startsWith(name))) return false;
  cur.row.splice(cur.idx - name.length, name.length);
  cur.idx -= name.length;
  const made = NAME_TO_NODE[name]();
  if (!isNode(made)) { insertItems([made]); return "char"; }
  if (made.t === "func" && made.name === "rand") { placeItems(cur.row, [made], cur.idx); cur.idx++; return "char"; }
  made.implicit = true;          // 괄호를 직접 치지 않고 만든 함수 (sin30 처럼)
  insertNode(made, made.t === "root" ? "body" : null);
  return "node";
}

/* ---------------------------------------------------------------------
   5-5. 지우기 (⌫)
   - 글자는 한 글자씩
   - 상자 바로 뒤에서 누르면: 빈 상자면 통째로 지우고, 내용이 있으면 상자 안으로 들어감
   - 빈칸 맨 앞에서 누르면: 상자를 풀어서 안의 내용만 남김
   --------------------------------------------------------------------- */
function nodeIsEmpty(n) { return slotRows(n).every((r) => r.length === 0) || (n.t === "root" && n.body.length === 0 && n.idx.length <= 1 && (n.idx.length === 0 || n.idx[0].v === "3")); }
function backspaceCore() {
  if (cur.idx > 0) {
    const it = cur.row[cur.idx - 1];
    if (!isNode(it) || nodeIsEmpty(it) || (it.t === "func" && it.name === "rand")) {
      cur.row.splice(cur.idx - 1, 1); cur.idx--;
    } else moveLeft();                                       // 상자 안으로 들어가서 지우게
    return;
  }
  // 빈칸 맨 앞
  const p = cur.row.parent;
  if (!p) return;
  const n = p.node, owner = n.ownerRow, at = owner.indexOf(n);
  const rows = slotRows(n), k = rows.indexOf(cur.row);
  if (nodeIsEmpty(n)) { owner.splice(at, 1); cur = { row: owner, idx: at }; return; }
  if (k > 0 && n.t !== "frac") { cur = { row: rows[k - 1], idx: rows[k - 1].length }; return; }
  // 상자 풀기: 분수는 분자 ÷ 분모, 루트·로그는 안쪽 내용만, 나머지는 내용을 이어 붙임
  let keep = rows, sep = null;
  if (n.t === "frac") sep = "÷";
  if (n.t === "func2" || n.t === "ncr" || n.t === "npr") sep = ",";
  if (n.t === "root" || n.t === "logb") keep = [rows[rows.length - 1]];
  const pieces = []; let offset = 0;
  keep.forEach((r, i) => {
    if (i > 0 && sep && r.length && pieces.length) pieces.push(mkChar(sep));
    if (r === cur.row) offset = pieces.length;
    pieces.push(...r);
  });
  owner.splice(at, 1);
  placeItems(owner, pieces, at);
  cur = { row: owner, idx: at + offset };
}

// 결과 숫자를 입력기 항목으로 (기록에서 결과를 눌렀을 때)
function numberToItems(v) {
  const f = formatNumber(v);
  const m = f.plain.match(/^(-?[\d.]+)×10\^(-?\d+)$/);
  let items;
  if (m) {
    items = [...m[1]].map(mkChar).concat([mkChar("×"), mkChar("1"), mkChar("0")]);
    const pw = mkNode("pow"); fillChars(pw.exp, m[2]); items.push(pw);
  } else items = [...f.plain].map(mkChar);
  if (v < 0) { const p = mkNode("par"); placeItems(p.body, items, 0); return [p]; }
  return items;
}

/* =====================================================================
   6. 화면 갱신
   ===================================================================== */
function refresh() {
  // --- 수식 그리기 ---
  rowRegistry = [];
  if (root.length === 0 && cur.row === root) {
    editorEl.innerHTML = `<span class="row" data-rid="0"><span class="m-ph on">${CURSOR}</span></span>
      <span class="hint">&nbsp; 아래 버튼으로 입력하세요. 분수, 지수 버튼을 누르면 빈칸이 생겨요</span>`;
    rowRegistry = [root];
  } else {
    editorEl.innerHTML = renderRow(root);
  }
  keepCursorVisible();
  // --- 미리 계산 (= 누르기 전, 흐리게) ---
  if (!state.justEvaluated) {
    resultEl.classList.remove("final");
    if (root.length === 0) { resultEl.innerHTML = ""; return; }
    try {
      const src = serialize(root);
      if (/rand/.test(src)) { resultEl.innerHTML = ""; return; }   // 난수는 미리 계산하지 않음
      resultEl.innerHTML = resultHTML(calculate(src));
    } catch (e) {
      resultEl.innerHTML = "";                                       // 입력 중 오류는 조용히
    }
  }
}
// 식이 길어서 옆으로 넘치면 커서가 보이게 스크롤
function keepCursorVisible() {
  const c = editorEl.querySelector(".cur");
  if (!c) return;
  const er = editorEl.getBoundingClientRect(), cr = c.getBoundingClientRect();
  if (cr.right > er.right - 12) editorEl.scrollLeft += cr.right - er.right + 24;
  else if (cr.left < er.left + 12) editorEl.scrollLeft -= er.left - cr.left + 24;
}

// 결과 줄 HTML: (분수 표시) = 값
function resultHTML(v) {
  const f = formatNumber(v);
  const fr = toFraction(v);
  const chip = fr ? `<span class="fracchip" title="분수로 나타내면">= <span class="m-frac"><span class="fn">${fr.n < 0 ? "−" : ""}${Math.abs(fr.n)}</span><span class="fd">${fr.d}</span></span></span>` : "";
  return `${chip}<span class="val">= ${f.html}</span>`;
}

/* =====================================================================
   7. = 누르기 (계산하고 기록에 저장)
   ===================================================================== */
function doEvaluate() {
  if (root.length === 0) return;
  const src = serialize(root);
  try {
    const v = calculate(src);
    state.ans = cleanNumber(v);
    state.justEvaluated = true;
    resultEl.classList.add("final");
    resultEl.innerHTML = resultHTML(v);
    $("ansInfo").innerHTML = `Ans = ${formatNumber(v).html}`;
    addHistory(src, v);
  } catch (e) {
    resultEl.classList.add("final");
    const msg = e instanceof CalcError ? e.message : "계산할 수 없는 식이에요";
    resultEl.innerHTML = `<span class="err">${esc(msg)}</span>`;
  }
}

/* =====================================================================
   8. 버튼·키 동작 처리
   ===================================================================== */
/* 방금 = 을 누른 뒤 새 입력이 오면:
   - 연산자(+, ×, 분수, x² 등)로 시작 → 앞에 Ans 를 붙여 이어서 계산
   - 숫자나 함수로 시작 → 새 식 시작
   - ◀ ▶ ⌫ → 방금 식을 고쳐 쓰기 */
function startAfterResult(afterAns) {
  if (!state.justEvaluated) return;
  state.justEvaluated = false;
  root = mkRow(null);
  cur = { row: root, idx: 0 };
  if (afterAns) insertChar("Ans");
}

// 동작 이름 → 실제 동작.  post=true 면 직전 결과에 이어 붙는 동작
function act(name, post) {
  const [cmd, arg] = name.split(":");
  // 화면 조작 동작
  if (cmd === "eval") { doEvaluate(); return; }
  if (cmd === "clear") { state.justEvaluated = false; root = mkRow(null); cur = { row: root, idx: 0 }; refresh(); return; }
  if (cmd === "deg") { toggleDeg(); return; }
  if (["left", "right", "up", "down", "back", "home", "end"].includes(cmd)) {
    if (state.justEvaluated) { state.justEvaluated = false; }
    if (cmd === "left") moveLeft();
    if (cmd === "right") moveRight();
    if (cmd === "up") moveVertical(-1);
    if (cmd === "down") moveVertical(1);
    if (cmd === "back") backspaceCore();
    if (cmd === "home") cur = { row: root, idx: 0 };
    if (cmd === "end") cur = { row: root, idx: root.length };
    refresh(); return;
  }
  // 입력 동작
  startAfterResult(post);
  if (cmd !== "ch" || !/^[A-Za-z]$/.test(arg)) {
    // 함수 이름을 치다가 다른 걸 누르면 함수로 바꿔 줌 (예: sin 다음 3 → sin(3))
    const made = convertName(true);
    if (made === "node" && cmd === "par") {                          // sin( 의 ( 는 이미 들어감
      cur.row.parent.node.implicit = false; refresh(); return;
    }
    // log 처럼 바로 바뀐 함수 다음에 ( 를 치면 괄호를 또 만들지 않음
    if (cmd === "par" && cur.row.parent && cur.row.parent.node.implicit && cur.row.length === 0) {
      cur.row.parent.node.implicit = false; refresh(); return;
    }
  }
  switch (cmd) {
    case "ch":
      // 값이 두 개인 상자(nCr, mod 등)의 첫 빈칸에서 쉼표 → 다음 빈칸으로 이동
      if (arg === "," && cur.row.parent) {
        const n = cur.row.parent.node, rows = slotRows(n), k = rows.indexOf(cur.row);
        if (rows.length > 1 && k < rows.length - 1 && n.t !== "frac") { cur = { row: rows[k + 1], idx: 0 }; break; }
      }
      insertChar(arg); if (/^[A-Za-z]$/.test(arg)) convertName(false); break;
    case "frac": insertFraction(); break;
    case "pow": insertPower(arg); break;
    case "sqrt": insertNode(mkNode("sqrt")); break;
    case "cbrt": { const n = mkNode("root"); fillChars(n.idx, "3"); insertNode(n, "body"); break; }
    case "root": insertNode(mkNode("root")); break;
    case "par": insertNode(mkNode("par")); break;
    case "exit": if (!exitParen()) toast("닫을 괄호가 없어요"); break;
    case "func": if (arg === "rand") { insertItems([mkNode("func", { name: "rand" })]); } else insertNode(mkNode("func", { name: arg })); break;
    case "func2": insertNode(mkNode("func2", { name: arg })); break;
    case "logb": insertNode(mkNode("logb")); break;
    case "ncr": insertNode(mkNode("ncr")); break;
    case "npr": insertNode(mkNode("npr")); break;
    case "abs": insertNode(mkNode("abs")); break;
    case "tenpow": insertChar("1"); insertChar("0"); insertPower(); break;    // 10ˣ
    case "epow": insertChar("e"); insertPower(); break;                       // eˣ
    case "sci": insertChar("×"); insertChar("1"); insertChar("0"); insertPower(); break;  // ×10ⁿ
  }
  refresh();
}

function toggleDeg() {
  state.deg = !state.deg;
  $("modeBadge").textContent = state.deg ? "DEG" : "RAD";
  document.querySelectorAll('[data-act="deg"]').forEach((b) => (b.textContent = state.deg ? "DEG" : "RAD"));
  toast(state.deg ? "각도 단위: 도(°)" : "각도 단위: 라디안(rad)");
  if (state.justEvaluated) doEvaluate(); else refresh();   // 바뀐 단위로 다시 계산
}

/* 키보드 글자 하나 → 동작 (노트북 키보드, 휴대폰 자판, 붙여넣기 공통) */
function typeChar(ch) {
  if (/\s/.test(ch)) return;
  if (/[0-9.]/.test(ch)) return act("ch:" + ch, false);
  if (/[A-Za-z]/.test(ch)) return act("ch:" + ch, false);
  const map = {
    "+": ["ch:+", true], "-": ["ch:-", true], "−": ["ch:-", true], "*": ["ch:×", true], "×": ["ch:×", true],
    "÷": ["ch:÷", true], "/": ["frac", true], "^": ["pow", true], "(": ["par", false], ")": ["exit", false],
    "[": ["par", false], "]": ["exit", false], ",": ["ch:,", false], "!": ["ch:!", true], "%": ["ch:%", true],
    "π": ["ch:π", false], "²": ["pow:2", true], "³": ["pow:3", true], "√": ["sqrt", false], "∛": ["cbrt", false],
  };
  if (!map[ch]) return;
  if ("+-−*×÷,/".includes(ch) && !state.justEvaluated) {   // 1/2/2 = (1/2)÷2 처럼 한 줄 수식 규칙
    convertName(true);              // sqrt 처럼 치던 이름이 있으면 먼저 함수로
    autoExitForTyping();
  }
  act(map[ch][0], map[ch][1]);
}

