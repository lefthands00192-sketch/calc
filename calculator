      <button class="top-btn" id="btnTheme" type="button" aria-haspopup="true">테마</button>
      <button class="top-btn" id="btnHistory" type="button">기록<span class="count" id="histCount">0</span></button>
    </div>
  </header>

  <main class="layout">
    <!-- ===== 계산기 본체 ===== -->
    <section class="calc" aria-label="계산기">
      <div class="display">
        <div class="disp-top">
          <span class="badge" id="modeBadge">DEG</span>
          <span class="ans-info" id="ansInfo">Ans = 0</span>
          <button class="kbd-btn" id="btnKbd" type="button" title="휴대폰 자판으로 직접 입력">자판 입력</button>
        </div>
        <!-- 교과서 모양 수식 입력칸: 빈칸을 눌러 커서를 옮기고, 버튼이나 키보드로 입력 -->
        <div class="editor" id="editor" tabindex="0" role="textbox" aria-label="수식 입력"></div>
        <!-- 결과 -->
        <div class="result" id="result" aria-live="polite"></div>
        <!-- 휴대폰 자판 입력을 받는 숨은 칸 -->
        <input id="kbdSink" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-hidden="true" tabindex="-1">
      </div>

      <!-- 키패드: 버튼은 아래 스크립트가 만들어 넣음 -->
      <div class="keys" id="keys">
        <div class="tabs" role="tablist" id="tabs"></div>
      </div>
    </section>

    <!-- ===== 계산 기록 ===== -->
    <aside class="history" id="history" aria-label="계산 기록">
      <div class="h-head">
        <h2>계산 기록 (<span id="histCount2">0</span>)</h2>
        <button class="h-btn" id="btnCopy" type="button">복사</button>
        <button class="h-btn" id="btnCsv" type="button">CSV 저장</button>
        <button class="h-btn danger" id="btnClearHist" type="button">전체 삭제</button>
        <button class="h-btn h-close" id="btnCloseHist" type="button">닫기</button>
      </div>
      <ul class="h-list" id="hList"></ul>
      <div class="h-tip">수식을 누르면 다시 불러와 고칠 수 있고, 결과를 누르면 지금 식에 넣어요. 기록은 새로고침하면 사라져요.</div>
    </aside>
  </main>

  <div class="backdrop" id="backdrop"></div>
