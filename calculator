// 버튼 하나 만들기
function makeKey(k, group) {
  const b = document.createElement("button");
  b.type = "button";
  b.className = `key ${k.c} ${k.sz || ""}`;
  b.dataset.group = group;
  b.dataset.act = k.a;
  b.innerHTML = k.a === "deg" ? (state.deg ? "DEG" : "RAD") : `<span class="kl">${k.l}</span>`;
  b.setAttribute("aria-label", k.t || b.textContent);
  if (k.t) b.title = k.t;
  b._key = k;
  return b;
}
// 탭 버튼
function buildTabs() {
  Object.entries(FUNC_TABS).forEach(([id, tab]) => {
    const t = document.createElement("button");
    t.type = "button"; t.className = "tab"; t.textContent = tab.name; t.dataset.tab = id;
    t.setAttribute("role", "tab");
    t.addEventListener("mousedown", (e) => e.preventDefault());       // 입력칸 초점 유지
    t.addEventListener("click", () => { state.tab = id; renderFuncKeys(); });
    tabsEl.appendChild(t);
  });
}
// 함수 탭 내용 (탭을 바꾸면 이 15개만 새로 그림)
function renderFuncKeys() {
  keysEl.querySelectorAll('[data-group="fn"]').forEach((b) => b.remove());
  const anchor = keysEl.querySelector('[data-group="pin"]');
  FUNC_TABS[state.tab].keys.forEach((k) => keysEl.insertBefore(makeKey(k, "fn"), anchor));
  tabsEl.querySelectorAll(".tab").forEach((t) => {
    t.classList.toggle("on", t.dataset.tab === state.tab);
    t.setAttribute("aria-selected", t.dataset.tab === state.tab);
  });
}
function buildKeys() {
  buildTabs();
  PIN_KEYS.forEach((k) => keysEl.appendChild(makeKey(k, "pin")));
  CTRL_KEYS.forEach((k) => keysEl.appendChild(makeKey(k, "ctl")));
  NUM_KEYS.forEach((k) => keysEl.appendChild(makeKey(k, "num")));
  renderFuncKeys();
}

/* 키패드 이벤트 (버튼마다 따로 달지 않고 한 곳에서 처리) */
let repeatTimer = null, repeatDelay = null;
function stopRepeat() { clearTimeout(repeatDelay); clearInterval(repeatTimer); repeatDelay = repeatTimer = null; }
keysEl.addEventListener("mousedown", (e) => { if (e.target.closest(".key")) e.preventDefault(); }); // 입력칸 초점 유지
keysEl.addEventListener("pointerdown", (e) => {
  const b = e.target.closest(".key");
  if (!b || b.dataset.act !== "back") return;
  // ⌫ 는 누르고 있으면 계속 지우기
  e.preventDefault();
  b.classList.add("pressed");
  act("back");
  repeatDelay = setTimeout(() => { repeatTimer = setInterval(() => act("back"), 70); }, 450);
});
["pointerup", "pointerleave", "pointercancel"].forEach((ev) =>
  keysEl.addEventListener(ev, () => { stopRepeat(); keysEl.querySelectorAll(".pressed").forEach((b) => b.classList.remove("pressed")); }));
keysEl.addEventListener("click", (e) => {
  const b = e.target.closest(".key");
  if (!b) return;
  if (b.dataset.act === "back" && e.detail !== 0) return;  // ⌫ 는 pointerdown 에서 이미 처리
  act(b._key.a, !!b._key.post);
  if (state.nativeKbd) $("kbdSink").focus();
});

/* =====================================================================
   10. 입력칸을 눌러서 커서 옮기기 + 키보드 입력
   ===================================================================== */
editorEl.addEventListener("pointerdown", (e) => {
  state.justEvaluated = false;
  const el = e.target.closest("[data-i],[data-rid]");
  if (!el || !editorEl.contains(el)) {
    // 빈 곳을 누르면 맨 끝으로
    cur = { row: root, idx: root.length };
  } else if (el.dataset.i !== undefined) {
    // 글자(또는 상자 테두리)를 누르면 그 글자의 왼쪽/오른쪽 절반에 따라 앞/뒤에 커서
    const row = rowRegistry[+el.dataset.rid], i = +el.dataset.i;
    const r = el.getBoundingClientRect();
    cur = { row, idx: e.clientX < r.left + r.width / 2 ? i : i + 1 };
  } else {
    // 빈칸이나 줄의 여백을 누르면: 그 줄에서 가장 가까운 자리
    const row = rowRegistry[+el.dataset.rid];
    const items = [...el.children].filter((c) => c.dataset.i !== undefined);
    let idx = 0;
    items.forEach((c) => { const r = c.getBoundingClientRect(); if (e.clientX > r.left + r.width / 2) idx = +c.dataset.i + 1; });
    cur = { row, idx: Math.min(idx, row.length) };
  }
  refresh();
  if (state.nativeKbd) { e.preventDefault(); $("kbdSink").focus(); }
});

// 키보드 (노트북): 입력칸이 아니라 문서 전체에서 받음 → 어디를 눌렀든 바로 타자 가능
document.addEventListener("keydown", (e) => {
  const tag = e.target.tagName;
  if (tag === "INPUT" || tag === "TEXTAREA") return;              // 숨은 자판 칸은 따로 처리
  if (e.target.closest && e.target.closest("button") && (e.key === "Enter" || e.key === " ")) return;
  if (e.ctrlKey || e.metaKey || e.altKey) return;                 // 복사·붙여넣기 등은 브라우저에 맡김
  const keyMap = {
    Enter: "eval", "=": "eval", Escape: "clear", Backspace: "back", ArrowLeft: "left", ArrowRight: "right",
    ArrowUp: "up", ArrowDown: "down", Home: "home", End: "end",
  };
  if (keyMap[e.key]) { e.preventDefault(); act(keyMap[e.key]); return; }
  if (e.key === "Delete") { e.preventDefault(); if (moveRight()) backspaceCore(); refresh(); return; }
  if (e.key.length === 1) { e.preventDefault(); typeChar(e.key); }
});
// 붙여넣기: 글자를 하나씩 친 것처럼 (/ 는 분수, ^ 는 지수로 바뀜)
document.addEventListener("paste", (e) => {
  if (e.target.tagName === "INPUT") return;
  const text = (e.clipboardData || window.clipboardData).getData("text");
  if (!text) return;
  e.preventDefault();
  [...text].forEach(typeChar);
});
// 복사: 지금 식을 글자 수식으로
document.addEventListener("copy", (e) => {
  if (e.target.tagName === "INPUT" || String(window.getSelection())) return;
  if (!root.length) return;
  e.preventDefault();
  e.clipboardData.setData("text/plain", serialize(root));
  toast("수식을 글자로 복사했어요");
});

/* 휴대폰: 기본은 계산기 버튼만 사용(자판 안 뜸). '자판 입력'을 켜면 숨은 칸으로 글자를 받아 넣음 */
const sink = $("kbdSink");
sink.addEventListener("beforeinput", (e) => {
  e.preventDefault();
  if (e.inputType && e.inputType.startsWith("delete")) { act("back"); return; }
  if (e.data) [...e.data].forEach(typeChar);
});
sink.addEventListener("input", () => {            // beforeinput 을 못 막는 옛 기기 대비
  const v = sink.value; sink.value = "";
  if (v) [...v].forEach(typeChar);
});
sink.addEventListener("keydown", (e) => {
  if (e.key === "Enter") { e.preventDefault(); act("eval"); }
  else if (e.key === "Backspace" && sink.value === "") { e.preventDefault(); act("back"); }
});
if (IS_TOUCH) $("btnKbd").style.display = "inline-block";
$("btnKbd").addEventListener("click", () => {
  state.nativeKbd = !state.nativeKbd;
  $("btnKbd").classList.toggle("on", state.nativeKbd);
  if (state.nativeKbd) sink.focus(); else sink.blur();
});

/* =====================================================================
   11. 계산 기록
   ===================================================================== */
function addHistory(src, v) {
  const f = formatNumber(v);
  const entry = {
    no: ++historyNo,
    time: new Date(),
    expr: src,
    value: cleanNumber(v),
    resultText: f.plain,
    insert: f.insert,
    html: f.html,
    mode: state.deg ? "DEG" : "RAD",
    tree: cloneRow(root, null),       // 교과서 모양 그대로 다시 불러오기 위해 식 구조도 저장
  };
  history.push(entry);
  renderHistory();
  saveToServer(entry);
}

/* 나중에 구글 앱스스크립트 웹앱에 넣을 때 기록을 스프레드시트로 보내는 자리.
   지금(깃허브/오프라인)은 google.script 가 없으므로 아무 일도 하지 않음.
   앱스스크립트 쪽 예시 (Code.gs):
     function saveCalcRecord(r) {
       const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('계산기록')
              || SpreadsheetApp.getActiveSpreadsheet().insertSheet('계산기록');
       sh.appendRow([new Date(), r.expr, r.result, r.mode]);
     }                                                                          */
function saveToServer(entry) {
  if (typeof google !== "undefined" && google.script && google.script.run) {
    google.script.run.withFailureHandler(() => {}).saveCalcRecord({
      expr: entry.expr, result: entry.resultText, mode: entry.mode,
    });
  }
}

function timeStr(d) { return d.toLocaleTimeString("ko-KR", { hour: "2-digit", minute: "2-digit", second: "2-digit" }); }

function renderHistory() {
  $("histCount").textContent = history.length;
  $("histCount2").textContent = history.length;
  if (history.length === 0) {
    hListEl.innerHTML = `<li class="h-empty">아직 계산 기록이 없어요.<br>
      = 을 누르면 여기에 차곡차곡 쌓여요.<br><br>
      <b>키보드로 입력할 때</b><br>
      <code>/</code> 분수, <code>^</code> 지수, <code>*</code> 곱하기<br>
      <code>sqrt</code> 루트, <code>sin</code> 등 함수 이름, <code>pi</code> 원주율<br>
      <code>→</code> 빈칸 밖으로, <code>↑ ↓</code> 분자/분모 이동<br>
      <code>Enter</code> 계산, <code>Esc</code> 모두 지우기</li>`;
    return;
  }
  // 최근 기록이 위로 오도록
  hListEl.innerHTML = history.slice().reverse().map((h) => {
    const exprHtml = renderStatic(h.tree);   // 입력했던 모양 그대로
    return `<li class="h-item" data-no="${h.no}">
      <span class="h-meta">#${h.no} · ${timeStr(h.time)} · ${h.mode}</span>
      <button class="h-expr" type="button" data-do="load" title="이 식 다시 불러오기">${exprHtml}</button>
      <button class="h-res" type="button" data-do="use" title="이 결과를 입력에 넣기">= ${h.html}</button>
      <button class="h-del" type="button" data-do="del" aria-label="이 기록 지우기">×</button>
    </li>`;
  }).join("");
}

hListEl.addEventListener("click", (e) => {
  const b = e.target.closest("button[data-do]");
  if (!b) return;
  const no = Number(b.closest(".h-item").dataset.no);
  const idx = history.findIndex((h) => h.no === no);
  if (idx < 0) return;
  const h = history[idx];
  if (b.dataset.do === "load") {                    // 식 다시 불러오기
    state.justEvaluated = false;
    resultEl.classList.remove("final");
    root = cloneRow(h.tree, null);
    cur = { row: root, idx: root.length };
    refresh();
    closeHistorySheet();
  } else if (b.dataset.do === "use") {              // 결과를 지금 식에 넣기
    startAfterResult(false);
    insertItems(numberToItems(h.value));
    refresh();
    closeHistorySheet();
    toast("결과를 입력에 넣었어요");
  } else if (b.dataset.do === "del") {
    history.splice(idx, 1);
    renderHistory();
  }
});

// 전체 복사
$("btnCopy").addEventListener("click", () => {
  if (!history.length) { toast("복사할 기록이 없어요"); return; }
  const text = history.map((h) => `${h.no}. ${h.expr} = ${h.resultText}`).join("\n");
  copyText(text).then(() => toast("기록을 복사했어요"), () => toast("복사하지 못했어요"));
});
function copyText(text) {
  if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
  // 파일로 직접 열었을 때 등: 예전 방식으로 복사
  return new Promise((ok, fail) => {
    const ta = document.createElement("textarea");
    ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
    document.body.appendChild(ta); ta.select();
    try { document.execCommand("copy") ? ok() : fail(); } catch (e) { fail(); }
    ta.remove();
  });
}
// CSV 파일로 저장 (엑셀에서 한글이 깨지지 않게 BOM 추가)
$("btnCsv").addEventListener("click", () => {
  if (!history.length) { toast("저장할 기록이 없어요"); return; }
  const q = (s) => `"${String(s).replace(/"/g, '""')}"`;
  const rows = [["번호", "시각", "수식", "결과", "각도"]].concat(
    history.map((h) => [h.no, timeStr(h.time), h.expr, h.resultText, h.mode]));
  const csv = "﻿" + rows.map((r) => r.map(q).join(",")).join("\r\n");
  const d = new Date(), p = (n) => String(n).padStart(2, "0");
  const name = `계산기록_${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}_${p(d.getHours())}${p(d.getMinutes())}.csv`;
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
  a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
});
// 전체 삭제: 실수 방지를 위해 두 번 눌러야 지워짐
let clearArmTimer = null;
$("btnClearHist").addEventListener("click", (e) => {
  const b = e.currentTarget;
  if (!history.length) { toast("지울 기록이 없어요"); return; }
  if (!b.classList.contains("armed")) {
    b.classList.add("armed"); b.textContent = "한 번 더 누르면 삭제";
    clearArmTimer = setTimeout(() => { b.classList.remove("armed"); b.textContent = "전체 삭제"; }, 2500);
    return;
  }
  clearTimeout(clearArmTimer);
  b.classList.remove("armed"); b.textContent = "전체 삭제";
  history.length = 0; renderHistory(); toast("기록을 모두 지웠어요");
});

// 휴대폰: 기록 창 열고 닫기
function openHistorySheet() { $("history").classList.add("open"); $("backdrop").classList.add("open"); }
function closeHistorySheet() { $("history").classList.remove("open"); $("backdrop").classList.remove("open"); }
$("btnHistory").addEventListener("click", openHistorySheet);
$("btnCloseHist").addEventListener("click", closeHistorySheet);
$("backdrop").addEventListener("click", () => { closeHistorySheet(); closeThemeMenu(); });

/* =====================================================================
   12. 테마
   ===================================================================== */
const THEMES = [
  { id: "yellow", name: "짙은 노랑 (기본)", sw: ["#d9a300", "#fff3c4", "#5a3e00", "#d9480f"] },
  { id: "night", name: "밤하늘", sw: ["#121a2b", "#2a3654", "#1f4a73", "#ffb703"] },
  { id: "mint", name: "민트", sw: ["#2aa78f", "#ffffff", "#0f4d41", "#ff7a59"] },
  { id: "sakura", name: "벚꽃", sw: ["#f19bb3", "#ffffff", "#7a2347", "#6a3fb5"] },
  { id: "ocean", name: "바다", sw: ["#2f6fb3", "#ffffff", "#123a63", "#ffb020"] },
  { id: "contrast", name: "고대비 (잘 보이게)", sw: ["#000000", "#ffffff", "#ffff00", "#00ffff"] },
];
function applyTheme(id) {
  if (!THEMES.some((t) => t.id === id)) id = "yellow";
  document.documentElement.dataset.theme = id;
  const bg = getComputedStyle(document.documentElement).getPropertyValue("--bg").trim();
  document.querySelector('meta[name="theme-color"]').setAttribute("content", bg);
  document.querySelectorAll(".theme-opt").forEach((o) => o.classList.toggle("on", o.dataset.id === id));
  try { localStorage.setItem("sci-calc-theme", id); } catch (e) { /* 저장 못 해도 괜찮음 */ }
}
function buildThemeMenu() {
  const menu = $("themeMenu");
  THEMES.forEach((t) => {
    const b = document.createElement("button");
    b.type = "button"; b.className = "theme-opt"; b.dataset.id = t.id;
    b.innerHTML = `<span class="swatch">${t.sw.map((c) => `<i style="background:${c}"></i>`).join("")}</span>${t.name}`;
    b.addEventListener("click", () => { applyTheme(t.id); closeThemeMenu(); });
    menu.appendChild(b);
  });
}
function closeThemeMenu() { $("themeMenu").classList.remove("open"); }
$("btnTheme").addEventListener("click", (e) => { e.stopPropagation(); $("themeMenu").classList.toggle("open"); });
document.addEventListener("click", (e) => { if (!e.target.closest("#themeMenu") && !e.target.closest("#btnTheme")) closeThemeMenu(); });

/* =====================================================================
   13. 알림 메시지
   ===================================================================== */
let toastTimer = null;
function toast(msg) {
  const t = $("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 1600);
}

/* =====================================================================
   14. 시작
   ===================================================================== */
buildKeys();
buildThemeMenu();
let savedTheme = "yellow";
try { savedTheme = localStorage.getItem("sci-calc-theme") || "yellow"; } catch (e) {}
applyTheme(savedTheme);
renderHistory();
refresh();
if (!IS_TOUCH) editorEl.focus({ preventScroll: true });

// 시험용으로 바깥에서 쓸 수 있게 (검증 스크립트용, 화면에는 영향 없음)
window.__calc = { calculate, formatNumber, toFraction, state, serialize: () => serialize(root) };
</script>
